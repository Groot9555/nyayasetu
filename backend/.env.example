# Copy to backend/.env and adjust. Never commit the real .env file.
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173

# Embeddings: "default" = local all-MiniLM-L6-v2 via ChromaDB (downloaded once, ~80 MB)
EMBEDDING_BACKEND=default

# LLM: "none" = extractive mode (shows retrieved passages only, no generated text)
#      "openai" = any OpenAI-compatible Chat Completions API (OpenAI, Groq, OpenRouter, local vLLM/Ollama, ...)
LLM_PROVIDER=none
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

RETRIEVAL_TOP_K=5
RETRIEVAL_STRONG_DISTANCE=0.40
RETRIEVAL_MAX_DISTANCE=0.70
MAX_REQUEST_BYTES=32000
RATE_LIMIT_PER_MINUTE=30
LOG_LEVEL=INFO
